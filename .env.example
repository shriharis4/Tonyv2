# Copy this file to .env and fill in real values. Never commit .env.

# --- LiveKit (required for voice sessions) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=tony

# --- AI provider ---
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Assistant identity/behavior ---
USER_NAME=Sir
TONY_VARIANT=Base
LAN=Hindi

# --- Email sending (optional) ---
# If any of these are missing, send_email will return a clear
# "not configured" message instead of silently failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
